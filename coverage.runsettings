<?xml version="1.0" encoding="utf-8"?>
<!--
  Code Coverage Configuration for Qwiq

  This file configures code coverage collection for the Qwiq test suite.

  Usage: dotnet test Qwiq.sln [settings flag] coverage.runsettings
  See TESTING.md or CONTRIBUTING.md for full command examples.

  For CI pipelines, use ReportGenerator to convert coverage files to HTML reports.

  Last updated: December 2024
  Reference: https://learn.microsoft.com/en-us/visualstudio/test/configure-unit-tests-by-using-a-dot-runsettings-file
-->
<RunSettings>
  <!--
    ═══════════════════════════════════════════════════════════════════════════════
    RUN CONFIGURATION
    Controls test execution environment and output locations.
    ═══════════════════════════════════════════════════════════════════════════════
  -->
  <RunConfiguration>
    <!--
      ResultsDirectory: Where test results (.trx) and coverage files are stored.
      Path is relative to the solution directory.
      Aligns with the repository's artifacts/ layout for CI consistency.
    -->
    <ResultsDirectory>.\artifacts\TestResults</ResultsDirectory>

    <!--
      TargetPlatform: x86 | x64
      - GitHub Actions provides only x64 .NET SDK
      - Use x64 for CI compatibility and modern development
      - Can be overridden via Test > Test Settings > Default Processor Architecture in VS
    -->
    <TargetPlatform>x64</TargetPlatform>

    <!--
      NOTE: TargetFrameworkVersion is intentionally omitted.
      The actual test framework is determined by each test project's <TargetFrameworks>
      setting (net472, net8.0) and the dotnet test /framework parameter.
      The legacy Framework45 setting is vestigial and ignored by modern MSTest.
    -->
  </RunConfiguration>

  <!--
    ═══════════════════════════════════════════════════════════════════════════════
    DATA COLLECTION (CODE COVERAGE)
    Configures the Microsoft Code Coverage data collector.
    ═══════════════════════════════════════════════════════════════════════════════
  -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <!--
        Microsoft Code Coverage Data Collector
        - Uses dynamic instrumentation to collect coverage data
        - Outputs .coverage files (binary format with full metrics)
        - For CI reporting, convert to Cobertura/HTML using ReportGenerator
      -->
      <DataCollector friendlyName="Code Coverage" uri="datacollector://Microsoft/CodeCoverage/2.0">
        <Configuration>
          <!--
            Format: Coverage | Cobertura | Xml
            - Coverage (default): Binary format with complete metrics, best for local analysis
            - Cobertura: XML format for CI tools (GitHub Actions, Azure Pipelines)

            We use Cobertura for CI-friendly output that integrates with GitHub Actions
            code coverage reporting and third-party tools like Codecov/Coveralls.
          -->
          <Format>cobertura</Format>

          <!--
            IncludeTestAssembly: Whether to collect coverage for test assemblies themselves.
            - False: Excludes assemblies that reference test frameworks (MSTest, xUnit, NUnit)
            - This prevents test code from inflating coverage metrics
            - Works in conjunction with ModulePaths exclusions for defense-in-depth
          -->
          <IncludeTestAssembly>False</IncludeTestAssembly>

          <!--
            SkipAutoProps: Whether to skip trivial auto-implemented properties.
            - True: Excludes simple { get; set; } properties with no logic
            - Properties with initializers, backing field access, or logic are still covered
            - Tradeoff: Slightly lower coverage % but more meaningful metrics
            - Note: CompilerGeneratedAttribute exclusion already handles backing fields
          -->
          <SkipAutoProps>true</SkipAutoProps>

          <CodeCoverage>
            <!--
              ═══════════════════════════════════════════════════════════════════
              MODULE PATHS
              Controls which assemblies are instrumented for coverage.
              Uses ECMAScript regex syntax. Order: Include first, then Exclude.
              ═══════════════════════════════════════════════════════════════════
            -->
            <ModulePaths>
              <!--
                Include: Explicitly list Qwiq assemblies to instrument.
                This is more precise than .*\.dll$ and avoids instrumenting
                third-party dependencies (Microsoft.*, Newtonsoft.*, etc.)

                Qwiq Assembly Map:
                - Qwiq.Core.dll           : Core interfaces and abstractions
                - Qwiq.Client.Rest.dll    : REST API client (net472, netstandard2.0, net8.0)
                - Qwiq.Client.Soap.dll    : SOAP client (net472 only, Windows)
                - Qwiq.Linq.dll           : LINQ query provider
                - Qwiq.Linq.Identity.dll  : LINQ identity extensions
                - Qwiq.Mapper.dll         : Object mapping layer
                - Qwiq.Mapper.Identity.dll: Mapper identity extensions
                - Qwiq.Identity.dll       : Identity management
                - Qwiq.Identity.Soap.dll  : Identity SOAP client (net472 only)
              -->
              <Include>
                <!-- Use .* prefix to match any path, then the assembly name -->
                <ModulePath>.*Qwiq\.Core\.dll$</ModulePath>
                <ModulePath>.*Qwiq\.Client\.Rest\.dll$</ModulePath>
                <ModulePath>.*Qwiq\.Client\.Soap\.dll$</ModulePath>
                <ModulePath>.*Qwiq\.Linq\.dll$</ModulePath>
                <ModulePath>.*Qwiq\.Linq\.Identity\.dll$</ModulePath>
                <ModulePath>.*Qwiq\.Mapper\.dll$</ModulePath>
                <ModulePath>.*Qwiq\.Mapper\.Identity\.dll$</ModulePath>
                <ModulePath>.*Qwiq\.Identity\.dll$</ModulePath>
                <ModulePath>.*Qwiq\.Identity\.Soap\.dll$</ModulePath>
              </Include>
              <!--
                Exclude: Defense-in-depth exclusions for test infrastructure.
                These patterns catch any test-related assemblies that might slip through.
              -->
              <Exclude>
                <!-- Test assemblies by naming convention -->
                <ModulePath>.*Tests.*</ModulePath>
                <ModulePath>.*\.Tests\.dll$</ModulePath>
                <ModulePath>.*UnitTests.*</ModulePath>
                <ModulePath>.*IntegrationTests.*</ModulePath>

                <!-- Mock and benchmark assemblies -->
                <ModulePath>.*Mocks.*</ModulePath>
                <ModulePath>.*Benchmark.*</ModulePath>

                <!-- Test framework infrastructure -->
                <ModulePath>.*TestAdapter.*</ModulePath>
                <ModulePath>.*\.TestAdapter\.dll$</ModulePath>
                <ModulePath>.*xunit.*</ModulePath>
                <ModulePath>.*nunit.*</ModulePath>
                <ModulePath>.*mstest.*</ModulePath>
              </Exclude>
            </ModulePaths>

            <!--
              ═══════════════════════════════════════════════════════════════════
              FUNCTIONS
              Excludes specific functions from coverage by fully qualified name.
              Uses regex patterns. Useful for excluding test harness code.
              ═══════════════════════════════════════════════════════════════════
            -->
            <Functions>
              <Exclude>
                <!-- MSTest internal methods -->
                <Function>.*::__GetTestMethodInfo.*</Function>

                <!-- Test framework namespaces -->
                <Function>^Microsoft\.Testing.*</Function>
                <Function>^Microsoft\.VisualStudio\.TestTools.*</Function>

                <!-- System diagnostics (tracing, debugging) - optional coverage -->
                <Function>^System\.Diagnostics.*</Function>
              </Exclude>
            </Functions>

            <!--
              ═══════════════════════════════════════════════════════════════════
              ATTRIBUTES
              Excludes code decorated with specific attributes.
              This is the primary mechanism for excluding generated/debug code.
              ═══════════════════════════════════════════════════════════════════
            -->
            <Attributes>
              <Exclude>
                <!--
                  Debugger attributes: Code hidden from debugger shouldn't need coverage.
                  These are typically infrastructure methods not meant for direct testing.
                -->
                <Attribute>^System\.Diagnostics\.DebuggerHiddenAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.DebuggerNonUserCodeAttribute$</Attribute>

                <!--
                  Generated code: Compiler and tool-generated code.
                  - CompilerGeneratedAttribute: Auto-properties, async state machines, iterators
                  - GeneratedCodeAttribute: Code from T4 templates, designers, etc.
                -->
                <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>

                <!--
                  Explicit exclusion: Developer-marked code to exclude from coverage.
                  Use [ExcludeFromCodeCoverage] on classes/methods that are intentionally untested.
                -->
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>

                <!--
                  Obsolete code: Deprecated code paths don't need coverage investment.
                -->
                <Attribute>^System\.ObsoleteAttribute$</Attribute>

                <!--
                  Test framework attributes: Exclude test classes themselves.
                  Note: IncludeTestAssembly=False handles most of this, but these
                  provide defense-in-depth for edge cases.
                -->
                <Attribute>^Microsoft\.VisualStudio\.TestTools\.UnitTesting\.TestClassAttribute$</Attribute>
              </Exclude>
            </Attributes>

            <!--
              ═══════════════════════════════════════════════════════════════════
              SOURCES
              Excludes source files by path pattern.
              Useful for excluding SDK/framework source files from coverage.
              ═══════════════════════════════════════════════════════════════════
            -->
            <Sources>
              <Exclude>
                <!-- Compatibility shims that are polyfills for older frameworks -->
                <Source>.*\\Compatibility\\.*</Source>

                <!-- Generated or temporary files -->
                <Source>.*\.g\.cs$</Source>
                <Source>.*\.generated\.cs$</Source>
              </Exclude>
            </Sources>

            <!--
              ═══════════════════════════════════════════════════════════════════
              PUBLIC KEY TOKENS
              Excludes assemblies signed with specific public key tokens.
              This prevents coverage collection for Microsoft/.NET framework assemblies.
              ═══════════════════════════════════════════════════════════════════
            -->
            <PublicKeyTokens>
              <Exclude>
                <!-- Microsoft .NET Framework and BCL -->
                <PublicKeyToken>^B77A5C561934E089$</PublicKeyToken>

                <!-- Microsoft shared libraries (System.*, Microsoft.*) -->
                <PublicKeyToken>^B03F5F7F11D50A3A$</PublicKeyToken>

                <!-- Microsoft Windows libraries -->
                <PublicKeyToken>^31BF3856AD364E35$</PublicKeyToken>

                <!-- Microsoft Visual Studio -->
                <PublicKeyToken>^89845DCD8080CC91$</PublicKeyToken>

                <!-- Microsoft ASP.NET -->
                <PublicKeyToken>^71E9BCE111E9429C$</PublicKeyToken>

                <!-- Microsoft SQL Server -->
                <PublicKeyToken>^8F50407C4E9E73B6$</PublicKeyToken>

                <!-- Microsoft Office -->
                <PublicKeyToken>^E361AF139669C375$</PublicKeyToken>

                <!-- Newtonsoft.Json -->
                <PublicKeyToken>^30AD4FE6B2A6AEED$</PublicKeyToken>
              </Exclude>
            </PublicKeyTokens>

            <!--
              ═══════════════════════════════════════════════════════════════════
              INSTRUMENTATION SETTINGS
              Controls how code is instrumented for coverage collection.
              ═══════════════════════════════════════════════════════════════════
            -->

            <!--
              UseVerifiableInstrumentation: Use CAS-compliant instrumentation.
              - True: Only instruments code that passes Code Access Security verification
              - False: Can instrument more code but may fail on some edge cases
              - CAS is deprecated in .NET 4.0+, but True is safer for compatibility
            -->
            <UseVerifiableInstrumentation>True</UseVerifiableInstrumentation>

            <!--
              AllowLowIntegrityProcesses: Allow coverage in sandboxed processes.
              - True: Enables coverage in Visual Studio test host sandboxing
              - Required for some test scenarios with restricted permissions
            -->
            <AllowLowIntegrityProcesses>True</AllowLowIntegrityProcesses>

            <!--
              CollectFromChildProcesses: Collect coverage from spawned processes.
              - True: Captures coverage from child processes (important for multi-TFM tests)
              - Essential when test host spawns separate processes for different frameworks
            -->
            <CollectFromChildProcesses>True</CollectFromChildProcesses>

            <!--
              CollectAspDotNet: Collect coverage from ASP.NET applications.
              - False: Qwiq is a library, not a web application
              - Disabling reduces overhead and avoids irrelevant instrumentation
            -->
            <CollectAspDotNet>False</CollectAspDotNet>

            <!--
              SingleHit: Record only whether a line was hit, not hit count.
              - False (default): Records hit counts for each line
              - True: Faster collection but loses frequency data
              - We keep False for complete metrics during analysis
            -->
            <SingleHit>False</SingleHit>

          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

  <!--
    ═══════════════════════════════════════════════════════════════════════════════
    MSTEST ADAPTER CONFIGURATION
    Settings specific to the MSTest test framework adapter.
    ═══════════════════════════════════════════════════════════════════════════════
  -->
  <MSTest>
    <!--
      MapInconclusiveToFailed: Treat inconclusive tests as failures.
      - True: Assert.Inconclusive() results in test failure
      - Ensures inconclusive tests are addressed rather than ignored
    -->
    <MapInconclusiveToFailed>True</MapInconclusiveToFailed>

    <!--
      CaptureTraceOutput: Capture Console.WriteLine and Trace output.
      - False: Reduces noise in test output
      - Set to True when debugging test failures that use trace output
    -->
    <CaptureTraceOutput>false</CaptureTraceOutput>

    <!--
      DeleteDeploymentDirectoryAfterTestRunIsComplete: Clean up deployment folder.
      - False: Preserves test artifacts for post-run analysis
      - Useful for debugging test failures in CI
    -->
    <DeleteDeploymentDirectoryAfterTestRunIsComplete>False</DeleteDeploymentDirectoryAfterTestRunIsComplete>

    <!--
      DeploymentEnabled: Enable MSTest deployment feature.
      - False: Disables legacy deployment (copying files to test directory)
      - Modern tests should use project references and build output directly
    -->
    <DeploymentEnabled>False</DeploymentEnabled>
  </MSTest>
</RunSettings>
