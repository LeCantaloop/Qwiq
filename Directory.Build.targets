<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    This file neutralizes GitVersionTask imports to prevent build failures.
    GitVersionTask 4.0.0 is incompatible with MSBuild 17.x on windows-latest.
    We're using Nerdbank.GitVersioning instead (see Directory.Build.props and version.json).
    
    This allows the build to succeed without removing all GitVersionTask package references
    from individual project files.
  -->
  
  <!-- Override the GitVersionTask target with a no-op -->
  <Target Name="GetVersion" />
  <Target Name="UpdateAssemblyInfo" />
  <Target Name="GenerateGitVersionInformation" />
  
  <!-- Neutralize the EnsureNuGetPackageBuildImports validation for GitVersionTask -->
  <Target Name="EnsureNuGetPackageBuildImports" />
</Project>
