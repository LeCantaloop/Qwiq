<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    This file provides build configuration overrides for all projects.
    
    1. Neutralizes GitVersionTask imports (incompatible with MSBuild 17.x)
    2. Disables legacy FxCop Code Analysis in Release builds (treats warnings as errors, failing CI)
    3. Neutralizes NuGet package import validation
  -->
  
  <!-- Override the GitVersionTask target with a no-op -->
  <Target Name="GetVersion" />
  <Target Name="UpdateAssemblyInfo" />
  <Target Name="GenerateGitVersionInformation" />
  
  <!-- Neutralize the EnsureNuGetPackageBuildImports validation -->
  <Target Name="EnsureNuGetPackageBuildImports" />
  
  <!-- Disable legacy FxCop Code Analysis in Release builds -->
  <!-- FxCop is deprecated in favor of Roslyn analyzers and treats warnings as errors, causing CI failures -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunCodeAnalysis>false</RunCodeAnalysis>
  </PropertyGroup>
</Project>
