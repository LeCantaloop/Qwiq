<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    This file provides build configuration overrides for all projects.
    
    1. Neutralizes GitVersionTask imports (incompatible with MSBuild 17.x)
    2. Neutralizes UtilPack.NuGet.MSBuild imports (missing package causing errors)
    3. Disables legacy FxCop Code Analysis in all builds
    4. Suppresses all FxCop warning codes (CA*)
    5. Neutralizes NuGet package import validation
  -->
  
  <!-- Disable legacy FxCop Code Analysis completely -->
  <!-- FxCop is deprecated in favor of Roslyn analyzers -->
  <PropertyGroup>
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <CodeAnalysisRuleSet></CodeAnalysisRuleSet>
    <!-- Suppress all Code Analysis warnings (CA* codes) -->
    <NoWarn>$(NoWarn);CA1000;CA1001;CA1002;CA1003;CA1004;CA1005;CA1006;CA1007;CA1008;CA1009;CA1010;CA1011;CA1012;CA1013;CA1014;CA1016;CA1017;CA1018;CA1019;CA1020;CA1021;CA1022;CA1023;CA1024;CA1025;CA1026;CA1027;CA1028;CA1030;CA1031;CA1032;CA1033;CA1034;CA1035;CA1036;CA1038;CA1039;CA1040;CA1041;CA1043;CA1044;CA1045;CA1046;CA1047;CA1048;CA1049;CA1050;CA1051;CA1052;CA1053;CA1054;CA1055;CA1056;CA1057;CA1058;CA1059;CA1060;CA1061;CA1062;CA1063;CA1064;CA1065;CA1300;CA1301;CA1302;CA1303;CA1304;CA1305;CA1306;CA1307;CA1308;CA1309;CA1400;CA1401;CA1402;CA1403;CA1404;CA1405;CA1406;CA1407;CA1408;CA1409;CA1410;CA1411;CA1412;CA1413;CA1414;CA1415;CA1500;CA1501;CA1502;CA1504;CA1505;CA1506;CA1600;CA1601;CA1700;CA1701;CA1702;CA1703;CA1704;CA1707;CA1708;CA1709;CA1710;CA1711;CA1712;CA1713;CA1714;CA1715;CA1716;CA1717;CA1719;CA1720;CA1721;CA1722;CA1724;CA1725;CA1726;CA1800;CA1801;CA1802;CA1803;CA1804;CA1806;CA1809;CA1810;CA1811;CA1812;CA1813;CA1814;CA1815;CA1816;CA1819;CA1820;CA1821;CA1822;CA1823;CA1824;CA1900;CA1901;CA1903;CA2000;CA2001;CA2002;CA2003;CA2004;CA2006;CA2007;CA2100;CA2101;CA2102;CA2103;CA2104;CA2105;CA2106;CA2107;CA2108;CA2109;CA2110;CA2111;CA2112;CA2114;CA2115;CA2116;CA2117;CA2118;CA2119;CA2120;CA2121;CA2122;CA2123;CA2124;CA2126;CA2127;CA2128;CA2129;CA2130;CA2131;CA2132;CA2133;CA2134;CA2135;CA2136;CA2137;CA2138;CA2139;CA2140;CA2141;CA2142;CA2143;CA2144;CA2145;CA2146;CA2147;CA2148;CA2149;CA2150;CA2151;CA2200;CA2201;CA2202;CA2204;CA2205;CA2207;CA2208;CA2210;CA2211;CA2212;CA2213;CA2214;CA2215;CA2216;CA2217;CA2218;CA2219;CA2220;CA2221;CA2222;CA2223;CA2224;CA2225;CA2226;CA2227;CA2228;CA2229;CA2230;CA2231;CA2232;CA2233;CA2234;CA2235;CA2236;CA2237;CA2238;CA2239;CA2240;CA2241;CA2242;CA2243;CA5122</NoWarn>
  </PropertyGroup>
  
  <!-- Override the GitVersionTask target with a no-op -->
  <Target Name="GetVersion" />
  <Target Name="UpdateAssemblyInfo" />
  <Target Name="GenerateGitVersionInformation" />
  
  <!-- Neutralize the EnsureNuGetPackageBuildImports validation -->
  <!-- This prevents errors for missing UtilPack.NuGet.MSBuild and other packages -->
  <Target Name="EnsureNuGetPackageBuildImports" />
</Project>
