#!/usr/bin/env bash
#
# Pre-commit hook for Qwiq repository
# AUTOMATICALLY FIXES linting issues and re-stages corrected files.
#
# Linters:
#   - markdownlint-cli2 for markdown files (auto-fix enabled)
#   - dotnet format for C# files (auto-fix enabled)
#   - pprettier (dotnet tool) for JSON/YAML files (auto-fix enabled)
#
# To enable: git config core.hooksPath .githooks
# To bypass:  git commit --no-verify (use sparingly)
#
# Environment variables:
#   SKIP_AUTOFIX=1  - Check only, don't auto-fix (CI mode)
#
# SECURITY NOTE (2025-12-13):
# This hook uses bash arrays and quoted expansions to safely pass filenames
# to external tools. This prevents shell injection attacks via malicious
# filenames containing metacharacters (;, `, $(), etc.).
# See: https://github.com/rjmurillo/Qwiq/pull/113#discussion_r2616633463
#

set -e

# Colors for output (if terminal supports it)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Check if we're in a terminal that supports colors
if [ ! -t 1 ]; then
    RED=''
    GREEN=''
    YELLOW=''
    CYAN=''
    NC=''
fi

echo_error() {
    echo -e "${RED}ERROR:${NC} $1"
}

echo_warning() {
    echo -e "${YELLOW}WARNING:${NC} $1"
}

echo_success() {
    echo -e "${GREEN}SUCCESS:${NC} $1"
}

echo_info() {
    echo "$1"
}

echo_action() {
    echo -e "${CYAN}FIXING:${NC} $1"
}

# Track overall exit status
EXIT_STATUS=0

# Track if any files were auto-fixed
FILES_FIXED=0

# Auto-fix mode (default: enabled)
AUTOFIX=1
if [ "${SKIP_AUTOFIX:-}" = "1" ]; then
    AUTOFIX=0
    echo_info "Auto-fix disabled (SKIP_AUTOFIX=1)"
fi

# Get repository root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Get staged files (Added, Copied, Modified, Renamed - excluding Deleted)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    echo_info "No staged files to check."
    exit 0
fi

# Filter files by extension
STAGED_MD_FILES=$(echo "$STAGED_FILES" | grep -E '\.md$' || true)
STAGED_CS_FILES=$(echo "$STAGED_FILES" | grep -E '\.cs$' || true)

#
# 1. Formatting with pprettier (dotnet tool)
#
if [ -n "$STAGED_FILES" ]; then
    echo_info "Checking JSON/YAML files..."

    if ! command -v dotnet &> /dev/null; then
        echo_warning "dotnet not found. Skipping JSON/YAML formatting."
    elif ! dotnet tool list 2>/dev/null | grep -q "packedprettier"; then
        echo_warning "pprettier not installed. Run 'dotnet tool restore'."
    else
        # Convert newline-delimited files to bash array (SECURITY: prevents shell injection)
        mapfile -t FILE_ARRAY <<< "$STAGED_FILES"

        if [ "$AUTOFIX" = "1" ]; then
            echo_action "Auto-fixing files..."
            # Fix in place
            # Use quoted array expansion to safely pass filenames
            dotnet pprettier --write "${STAGED_FILES[@]}" 2>/dev/null || true
        fi

        # Verify the files pass now
        # Use quoted array expansion to safely pass filenames
        if ! dotnet pprettier --check "${STAGED_FILES[@]}" 2>&1; then
            echo_error "Formatting failed."
            echo_info "  Fix with: dotnet pprettier --write ."
            EXIT_STATUS=1
        else
            # Check if files were modified by the fix
            # Use quoted array iteration to safely handle filenames with spaces/metacharacters
            for file in "${STAGED_FILES[@]}"; do
                if [ -f "$file" ] && ! git diff --quiet -- "$file" 2>/dev/null; then
                    echo_success "Fixed: $file"
                    git add "$file"
                    FILES_FIXED=1
                fi
            done
            echo_success "Files formatted successfully."
        fi
    fi
fi

#
# 2. Markdown Linting with markdownlint-cli2
#
if [ -n "$STAGED_MD_FILES" ]; then
    echo_info "Checking markdown files..."

    if ! command -v npx &> /dev/null; then
        echo_warning "npx not found. Skipping markdown linting."
    else
        # Convert newline-delimited files to bash array (SECURITY: prevents shell injection)
        mapfile -t MD_FILE_ARRAY <<< "$STAGED_MD_FILES"

        # First, try to auto-fix
        if [ "$AUTOFIX" = "1" ]; then
            echo_action "Auto-fixing markdown files..."
            # Fix in place (ignore exit code, we'll verify after)
            # Use quoted array expansion to safely pass filenames
            npx markdownlint-cli2 --fix --no-globs "${MD_FILE_ARRAY[@]}" 2>/dev/null || true
        fi

        # Verify the files pass linting now
        # Use quoted array expansion to safely pass filenames
        if ! npx markdownlint-cli2 --no-globs "${MD_FILE_ARRAY[@]}" 2>&1; then
            echo_error "Markdown linting failed (some issues cannot be auto-fixed)."
            echo_info "  Review errors above and fix manually."
            EXIT_STATUS=1
        else
            # Check if files were modified by the fix
            # Use quoted array iteration to safely handle filenames with spaces/metacharacters
            for file in "${MD_FILE_ARRAY[@]}"; do
                if [ -f "$file" ] && ! git diff --quiet -- "$file" 2>/dev/null; then
                    echo_success "Fixed: $file"
                    git add "$file"
                    FILES_FIXED=1
                fi
            done
            echo_success "Markdown files OK."
        fi
    fi
fi

#
# 3. C# Formatting with dotnet format
#
if [ -n "$STAGED_CS_FILES" ]; then
    echo_info "Checking C# files..."

    if ! command -v dotnet &> /dev/null; then
        echo_warning "dotnet not found. Skipping C# formatting."
    elif [ ! -f "Qwiq.sln" ]; then
        echo_warning "Qwiq.sln not found. Skipping C# formatting."
    else
        # Convert newline-delimited files to bash array (SECURITY: prevents shell injection)
        mapfile -t CS_FILE_ARRAY <<< "$STAGED_CS_FILES"

        # Build include arguments array (each --include and filename is separate element)
        # This prevents shell metacharacters in filenames from breaking the command
        CS_INCLUDE_ARGS=()
        for file in "${CS_FILE_ARRAY[@]}"; do
            normalized_file=$(echo "$file" | sed 's/\\/\//g')
            CS_INCLUDE_ARGS+=("--include" "$normalized_file")
        done

        if [ "$AUTOFIX" = "1" ]; then
            echo_action "Auto-fixing C# files..."
            # Run format (fix in place)
            # Use quoted array expansion to safely pass arguments
            dotnet format Qwiq.sln --no-restore "${CS_INCLUDE_ARGS[@]}" 2>&1 || true
        fi

        # Verify the files pass now
        # Use quoted array expansion to safely pass arguments
        if ! dotnet format Qwiq.sln --verify-no-changes --no-restore "${CS_INCLUDE_ARGS[@]}" 2>&1; then
            echo_error "C# formatting failed."
            echo_info "  Fix with: dotnet format"
            EXIT_STATUS=1
        else
            # Check if files were modified by the fix
            # Use quoted array iteration to safely handle filenames with spaces/metacharacters
            for file in "${CS_FILE_ARRAY[@]}"; do
                if [ -f "$file" ] && ! git diff --quiet -- "$file" 2>/dev/null; then
                    echo_success "Fixed: $file"
                    git add "$file"
                    FILES_FIXED=1
                fi
            done
            echo_success "C# files OK."
        fi
    fi
fi

#
# Final Summary
#
echo ""
if [ $EXIT_STATUS -ne 0 ]; then
    echo_error "Pre-commit checks failed. Please fix the issues above."
    echo_info "  To bypass (use sparingly): git commit --no-verify"
    exit 1
fi

if [ "$FILES_FIXED" = "1" ]; then
    echo_success "All checks passed. Some files were auto-fixed and re-staged."
else
    echo_success "All pre-commit checks passed."
fi
exit 0
