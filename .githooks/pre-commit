#!/usr/bin/env bash
#
# Pre-commit hook for Qwiq repository
# Enforces linting before commits using documented linters:
#   - markdownlint-cli2 for markdown files
#   - dotnet format for C# files
#   - pprettier (dotnet tool) for JSON/YAML files
#
# To enable: git config core.hooksPath .githooks
# To bypass:  git commit --no-verify (use sparingly)

set -e

# Colors for output (if terminal supports it)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if we're in a terminal that supports colors
if [ ! -t 1 ]; then
    RED=''
    GREEN=''
    YELLOW=''
    NC=''
fi

echo_error() {
    echo -e "${RED}ERROR:${NC} $1"
}

echo_warning() {
    echo -e "${YELLOW}WARNING:${NC} $1"
}

echo_success() {
    echo -e "${GREEN}SUCCESS:${NC} $1"
}

echo_info() {
    echo "$1"
}

# Track overall exit status
EXIT_STATUS=0

# Get repository root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Get staged files (Added, Copied, Modified, Renamed - excluding Deleted)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    echo_info "No staged files to check."
    exit 0
fi

# Filter files by extension
STAGED_MD_FILES=$(echo "$STAGED_FILES" | grep -E '\.md$' || true)
STAGED_CS_FILES=$(echo "$STAGED_FILES" | grep -E '\.cs$' || true)
STAGED_JSON_YAML_FILES=$(echo "$STAGED_FILES" | grep -E '\.(json|ya?ml)$' || true)

#
# 1. Markdown Linting with markdownlint-cli2
#
if [ -n "$STAGED_MD_FILES" ]; then
    echo_info "Checking markdown files with markdownlint-cli2..."

    # Check if npx is available
    if ! command -v npx &> /dev/null; then
        echo_error "npx not found. Install Node.js to enable markdown linting."
        echo_info "  Download: https://nodejs.org/"
        EXIT_STATUS=1
    else
        # Convert to space-separated list for npx
        # Use --no-globs to prevent config's glob patterns from expanding to all files
        MD_FILE_LIST=$(echo "$STAGED_MD_FILES" | tr '\n' ' ')

        if ! npx markdownlint-cli2 --no-globs $MD_FILE_LIST; then
            echo_error "Markdown linting failed."
            echo_info "  Fix with: npx markdownlint-cli2 --fix \"**/*.md\""
            EXIT_STATUS=1
        else
            echo_success "Markdown files passed linting."
        fi
    fi
fi

#
# 2. C# Formatting with dotnet format
#
if [ -n "$STAGED_CS_FILES" ]; then
    echo_info "Checking C# files with dotnet format..."

    # Check if dotnet is available
    if ! command -v dotnet &> /dev/null; then
        echo_error "dotnet not found. Install .NET SDK to enable C# formatting checks."
        echo_info "  Download: https://dot.net/"
        EXIT_STATUS=1
    else
        # Check if solution can be found
        if [ ! -f "Qwiq.sln" ]; then
            echo_warning "Qwiq.sln not found. Skipping dotnet format."
        else
            # Build include arguments for dotnet format
            # Convert to comma-separated list of relative paths
            CS_INCLUDE_ARGS=""
            for file in $STAGED_CS_FILES; do
                # Normalize path separators for cross-platform
                normalized_file=$(echo "$file" | sed 's/\\/\//g')
                if [ -z "$CS_INCLUDE_ARGS" ]; then
                    CS_INCLUDE_ARGS="--include $normalized_file"
                else
                    CS_INCLUDE_ARGS="$CS_INCLUDE_ARGS --include $normalized_file"
                fi
            done

            # Run dotnet format with --verify-no-changes
            # Using --no-restore to speed up (assumes restore was done during development)
            if ! dotnet format Qwiq.sln --verify-no-changes --no-restore $CS_INCLUDE_ARGS 2>&1; then
                echo_error "C# formatting check failed."
                echo_info "  Fix with: dotnet format"
                EXIT_STATUS=1
            else
                echo_success "C# files passed formatting check."
            fi
        fi
    fi
fi

#
# 3. JSON/YAML Formatting with pprettier (dotnet tool)
#
if [ -n "$STAGED_JSON_YAML_FILES" ]; then
    echo_info "Checking JSON/YAML files with pprettier..."

    # Check if dotnet is available
    if ! command -v dotnet &> /dev/null; then
        echo_error "dotnet not found. Install .NET SDK to enable prettier checks."
        echo_info "  Download: https://dot.net/"
        EXIT_STATUS=1
    else
        # Check if pprettier tool is available
        if ! dotnet tool list | grep -q "packedprettier"; then
            echo_warning "pprettier tool not installed. Run 'dotnet tool restore' first."
            echo_info "  Fix with: dotnet tool restore"
            EXIT_STATUS=1
        else
            # Convert to space-separated list for pprettier
            JSON_YAML_FILE_LIST=$(echo "$STAGED_JSON_YAML_FILES" | tr '\n' ' ')

            if ! dotnet pprettier --check $JSON_YAML_FILE_LIST 2>&1; then
                echo_error "JSON/YAML formatting check failed."
                echo_info "  Fix with: dotnet pprettier --write ."
                EXIT_STATUS=1
            else
                echo_success "JSON/YAML files passed formatting check."
            fi
        fi
    fi
fi

#
# Final Summary
#
if [ $EXIT_STATUS -ne 0 ]; then
    echo ""
    echo_error "Pre-commit checks failed. Please fix the issues above before committing."
    echo_info "  To bypass (use sparingly): git commit --no-verify"
    exit 1
fi

echo ""
echo_success "All pre-commit checks passed."
exit 0
