###############################
# Git Line Endings            #
###############################

# Set default behavior to automatically normalize line endings.
* text=auto

# Force Windows command and batch scripts to keep CRLF endings so they
# continue to execute correctly when accessed from Linux via file shares.
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf
*.ps1 text eol=crlf

# Ensure cross-platform tooling continues to function when run from Linux
# agents by keeping Unix shell scripts with LF endings.
*.sh text eol=lf

# Visual Studio generated files expect CRLF in the working tree. Keeping the
# default line endings avoids noisy diffs when the files are touched on Linux.
*.sln text eol=crlf
*.csproj text eol=crlf
*.vcxproj text eol=crlf
*.fsproj text eol=crlf

###############################
# Diff Drivers                #
###############################

# Provide syntax-aware diffs for C# files when using command-line Git.
*.cs diff=csharp

###############################
# Snapshot Testing Artifacts  #
###############################

# Per https://github.com/VerifyTests/Verify#conventions all *.verified.* files
# should be committed and retain consistent line endings across platforms.
*.verified.txt text eol=lf working-tree-encoding=UTF-8
*.verified.xml text eol=lf working-tree-encoding=UTF-8
*.verified.nuspec text eol=lf working-tree-encoding=UTF-8
*.verified.json text eol=lf working-tree-encoding=UTF-8
*.verified.bin binary
*.verified.nupkg binary
*.nupkg.verified binary
*.verified.snupkg binary
*.snupkg.verified binary

###############################
# Optional Git LFS Rules      #
###############################

# The default `dotnet new gitattributes` template includes Git LFS filters for
# large binary assets (archives, images, fonts, executables). Qwiq does not use
# Git LFS today, so the rules are documented here for future reference without
# enabling the filters by default.
#
# Example (uncomment when Git LFS is enabled):
# *.png filter=lfs diff=lfs merge=lfs -text
