<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Integration tests require TFS Extended Client - .NET Framework only -->
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Qwiq.IntegrationTests</RootNamespace>
    <AssemblyName>Qwiq.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.VisualStudio.Services.Client" />
    <PackageReference Include="Microsoft.TeamFoundationServer.ExtendedClient" />
    <PackageReference Include="JetBrains.DotMemoryUnit" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Moq.Analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Qwiq.Core\Qwiq.Core.csproj" SetTargetFramework="TargetFramework=net472" />
    <ProjectReference Include="..\..\src\Qwiq.Core.Rest\Qwiq.Client.Rest.csproj" SetTargetFramework="TargetFramework=net472" />
    <ProjectReference Include="..\..\src\Qwiq.Core.Soap\Qwiq.Client.Soap.csproj" />
    <ProjectReference Include="..\..\src\Qwiq.Identity\Qwiq.Identity.csproj" SetTargetFramework="TargetFramework=net472" />
    <ProjectReference Include="..\..\src\Qwiq.Identity.Soap\Qwiq.Identity.Soap.csproj" />
    <ProjectReference Include="..\..\src\Qwiq.Linq\Qwiq.Linq.csproj" SetTargetFramework="TargetFramework=net472" />
    <ProjectReference Include="..\..\src\Qwiq.Linq.Identity\Qwiq.Linq.Identity.csproj" SetTargetFramework="TargetFramework=net472" />
    <ProjectReference Include="..\..\src\Qwiq.Mapper\Qwiq.Mapper.csproj" SetTargetFramework="TargetFramework=net472" />
    <ProjectReference Include="..\..\src\Qwiq.Mapper.Identity\Qwiq.Mapper.Identity.csproj" SetTargetFramework="TargetFramework=net472" />
    <ProjectReference Include="..\Qwiq.Mocks\Qwiq.Mocks.csproj" SetTargetFramework="TargetFramework=net472" />
    <ProjectReference Include="..\Qwiq.Tests.Common\Qwiq.Tests.Common.csproj" SetTargetFramework="TargetFramework=net472" />
  </ItemGroup>

  <!-- InternalsVisibleTo for testing -->
  <ItemGroup>
    <InternalsVisibleTo Include="Qwiq.Test" />
  </ItemGroup>

  <!-- Copy WireMock stubs to output directory -->
  <ItemGroup>
    <None Include="WireMock\Stubs\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>WireMock\Stubs\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
