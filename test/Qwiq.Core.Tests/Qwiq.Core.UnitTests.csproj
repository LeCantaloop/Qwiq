<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net48;net481;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Qwiq</RootNamespace>
    <AssemblyName>Qwiq.Core.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.VisualStudio.Services.Client" />
    <PackageReference Include="Microsoft.TeamFoundationServer.Client" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Moq.Analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\Qwiq.Core\Qwiq.Core.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
    <ProjectReference Include="$(RepoRoot)\test\Qwiq.Mocks\Qwiq.Mocks.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
    <ProjectReference Include="$(RepoRoot)\test\Qwiq.Tests.Common\Qwiq.Tests.Common.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
  </ItemGroup>

  <!-- Include REST client for unit testing -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\Qwiq.Core.Rest\Qwiq.Client.Rest.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
  </ItemGroup>

  <!-- Include SOAP client only for net472 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <ProjectReference Include="$(RepoRoot)\src\Qwiq.Core.Soap\Qwiq.Client.Soap.csproj" SetTargetFramework="TargetFramework=net472" />
  </ItemGroup>

  <!-- Include Integration.Tests for TestData and IntegrationSettings used by REST integration tests (only for net472) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <ProjectReference Include="$(RepoRoot)\test\Qwiq.Integration.Tests\Qwiq.IntegrationTests.csproj" SetTargetFramework="TargetFramework=net472" />
  </ItemGroup>

  <!-- Exclude REST integration tests from non-net472 builds (they require Integration.Tests which only targets net472) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <Compile Remove="Client\Rest\RestWorkItemStoreQueryTests.cs" />
  </ItemGroup>

</Project>
