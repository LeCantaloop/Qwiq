root=true

[*]
trim_trailing_whitespace = true
indent_style = space
end_of_line = crlf

[*.cs]
indent_size = 4

# Verify settings
[*.{received,verified}.{json,txt,xml}]
charset = utf-8-bom
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false
