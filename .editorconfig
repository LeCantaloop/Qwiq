root=true

[*]
trim_trailing_whitespace = true
indent_style = space
end_of_line = crlf

[*.cs]
indent_size = 4

#######################################
# Analyzer Severity Configuration
# These represent existing technical debt or intentional suppressions
#######################################

# CS1591: Missing XML comment for publicly visible type or member
# KEPT: ~4200 violations - adding XML docs is a significant effort tracked separately
dotnet_diagnostic.CS1591.severity = none

# CS0618: Member is obsolete (e.g., TimeZone)
# KEPT: TimeZone is used in public interfaces IWorkItemStore and ITfsTeamProjectCollection.
# Changing to TimeZoneInfo would be a breaking API change affecting 9+ implementations.
dotnet_diagnostic.CS0618.severity = none



#######################################
# CA17xx: Naming Rules
#######################################

# CA1707: Identifiers should not contain underscores
# KEPT: Test classes and methods use Given_When_Then naming pattern (868 violations)
dotnet_diagnostic.CA1707.severity = none

# CA1716: Identifiers should not match keywords
# KEPT: When() method is part of established test specification pattern;
# 'property' parameter name is standard for reflection APIs (78 violations)
dotnet_diagnostic.CA1716.severity = none

#######################################
# CA18xx: Performance Rules
#######################################

# CA1822: Mark members as static
# KEPT: Some instance methods could be static but are kept for API compatibility (36 violations)
dotnet_diagnostic.CA1822.severity = none

# CA1859: Use concrete types when possible for improved performance
# KEPT: Interface types used intentionally for abstraction and testability (30 violations)
dotnet_diagnostic.CA1859.severity = none

# CA1863: Cache a CompositeFormat for repeated use
# Requires .NET 8+ API, not available on older targets
dotnet_diagnostic.CA1863.severity = none

#######################################
# Test Project Specific Rules
#######################################
[test/**/*.cs]
# CA2263: Prefer generic overload
# Tests deliberately test both generic and non-generic overloads for coverage
dotnet_diagnostic.CA2263.severity = none

# Verify settings
[*.{received,verified}.{json,txt,xml,nuspec}]
charset = utf-8-bom
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false
