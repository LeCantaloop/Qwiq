{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 10am on monday"],
  "timezone": "America/Los_Angeles",
  "labels": ["dependencies"],
  "assignees": ["@rjmurillo"],
  "packageRules": [
    {
      "description": "Pin GitHub Actions to commit SHAs for supply chain security",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "commitMessagePrefix": "ci:",
      "commitMessageAction": "pin",
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group NuGet test dependencies together",
      "matchManagers": ["nuget"],
      "matchPackagePatterns": ["^MSTest\\.", "^coverlet\\.", "^xunit", "^Verify\\.", "^Shouldly$"],
      "groupName": "NuGet test dependencies",
      "commitMessagePrefix": "deps:"
    },
    {
      "description": "Group NuGet analyzer dependencies together",
      "matchManagers": ["nuget"],
      "matchPackagePatterns": ["Microsoft\\.CodeAnalysis\\.", "\\.Analyzers$"],
      "groupName": "NuGet analyzers",
      "commitMessagePrefix": "deps:"
    },
    {
      "description": "Ignore Azure DevOps SDK packages (require careful coordination)",
      "matchManagers": ["nuget"],
      "matchPackagePatterns": ["^Microsoft\\.TeamFoundationServer\\.", "^Microsoft\\.VisualStudio\\.Services\\."],
      "enabled": false
    },
    {
      "description": ".NET SDK updates",
      "matchManagers": ["dotnet-sdk"],
      "commitMessagePrefix": "chore:",
      "commitMessageAction": "update"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "assignees": ["@rjmurillo"]
  }
}
