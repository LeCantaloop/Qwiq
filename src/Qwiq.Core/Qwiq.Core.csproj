<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <RootNamespace>Qwiq</RootNamespace>
    <AssemblyName>Qwiq.Core</AssemblyName>
    <Description>QWIQ Core - Quick Work Item Query library for Azure DevOps / TFS</Description>
    <PackageId>Qwiq.Core</PackageId>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Package Validation: Detect breaking API changes automatically -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- PackageValidationBaselineVersion will be set after next release -->
    <EnableStrictModeForCompatibleTfms>true</EnableStrictModeForCompatibleTfms>
    <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\package-readme\Qwiq.Core.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qwiq.Core.UnitTests" />
    <InternalsVisibleTo Include="Qwiq.Mocks" />
    <InternalsVisibleTo Include="Qwiq.Client.Soap" />
    <InternalsVisibleTo Include="Qwiq.Client.Rest" />
    <InternalsVisibleTo Include="Qwiq.Integration.Tests" />
    <InternalsVisibleTo Include="Qwiq.Relatives.Tests" />
    <InternalsVisibleTo Include="Qwiq.IntegrationTests" />
    <InternalsVisibleTo Include="Qwiq.Identity.Soap" />
    <InternalsVisibleTo Include="Qwiq.Mapper" />
    <InternalsVisibleTo Include="Qwiq.Mapper.Identity" />
    <InternalsVisibleTo Include="Qwiq.Identity.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Castle.Core" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.VisualStudio.Services.Client" />
    <PackageReference Include="Microsoft.VisualStudio.Services.InteractiveClient" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Framework-specific PublicAPI files for polyfill types that only exist in net472 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <AdditionalFiles Include="PublicAPI.Shipped.net472.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.net472.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.txt" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
