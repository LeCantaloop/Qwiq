<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <RootNamespace>Qwiq.Client.Rest</RootNamespace>
    <AssemblyName>Qwiq.Client.Rest</AssemblyName>
    <Description>QWIQ REST Client - Azure DevOps REST-based Work Item client</Description>
    <PackageId>Qwiq.Client.Rest</PackageId>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Package Validation: Detect breaking API changes automatically -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- PackageValidationBaselineVersion will be set after next release -->
    <EnableStrictModeForCompatibleTfms>true</EnableStrictModeForCompatibleTfms>
    <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\package-readme\Qwiq.Client.Rest.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qwiq.IntegrationTests" />
    <InternalsVisibleTo Include="Qwiq.Integration.Tests" />
    <InternalsVisibleTo Include="Qwiq.Core.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Services.Client" />
    <PackageReference Include="Microsoft.TeamFoundationServer.Client" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" />
  </ItemGroup>

  <!-- System.Runtime needed for net472 to resolve type conflicts with TFS client libraries -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link polyfill files from Qwiq.Core for compatibility on older frameworks -->
    <Compile Include="..\Qwiq.Core\Compatibility\NullableAttributes.cs" Link="Compatibility\NullableAttributes.cs" />
    <Compile Include="..\Qwiq.Core\Compatibility\EmbeddedAttribute.cs" Link="Compatibility\EmbeddedAttribute.cs" />
    <Compile Include="..\Qwiq.Core\Compatibility\CallerArgumentExpressionAttribute.cs" Link="Compatibility\CallerArgumentExpressionAttribute.cs" />
    <Compile Include="..\Qwiq.Core\Compatibility\ArgumentNullExceptionPolyfill.cs" Link="Compatibility\ArgumentNullExceptionPolyfill.cs" />
    <Compile Include="..\Qwiq.Core\Compatibility\ArgumentOutOfRangeExceptionPolyfill.cs" Link="Compatibility\ArgumentOutOfRangeExceptionPolyfill.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qwiq.Core\Qwiq.Core.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
