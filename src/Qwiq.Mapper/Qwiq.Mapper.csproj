<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <RootNamespace>Qwiq.Mapper</RootNamespace>
    <AssemblyName>Qwiq.Mapper</AssemblyName>
    <Description>QWIQ Mapper - Object mapping for Azure DevOps / TFS Work Items</Description>
    <PackageId>Qwiq.Mapper</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastMember" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qwiq.Core\Qwiq.Core.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
    <ProjectReference Include="..\Qwiq.Linq\Qwiq.Linq.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
  </ItemGroup>
</Project>
