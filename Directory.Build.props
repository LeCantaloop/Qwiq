<Project>
  <PropertyGroup>
    <!-- Use modern .NET 8 as default, with net472 for Windows-specific components -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Build Configuration -->
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

    <!-- Compiler Settings -->
    <FileAlignment>512</FileAlignment>
    <HighEntropyVA>true</HighEntropyVA>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress: 1591=missing XML comments, CS0618=obsolete TimeZone, CS3001/CS3003=CLS compliance, SYSLIB0051=obsolete serialization -->
    <!-- CS1574/CS1710=XML comment cref issues, SYSLIB0021=MD5CryptoServiceProvider obsolete -->
    <!-- CS86xx=nullable reference type warnings (suppressed for gradual migration) -->
    <NoWarn>$(NoWarn);1591;CS0618;CS3001;CS3002;CS3003;CS3005;CS3006;CS3008;CS3009;CS3014;CS3015;CS3016;CS3024;CS3026;CS3027;SYSLIB0051;SYSLIB0050;CA1510;CA1512;CA1511;CA1513;CA1863;CS1574;CS1710;SYSLIB0021;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8625;CS8629;CS8764;CS8765;CS8766;CS8767;CS8769</NoWarn>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>

    <!-- Output Configuration -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>

    <!-- Enable SDK analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Disable legacy Code Analysis -->
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <CodeAnalysisRuleSet></CodeAnalysisRuleSet>

    <!-- Assembly Info - SDK-generated attributes -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyCompanyAttribute>true</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>true</GenerateAssemblyProductAttribute>
    <GenerateAssemblyCopyrightAttribute>true</GenerateAssemblyCopyrightAttribute>
    <GenerateAssemblyConfigurationAttribute>true</GenerateAssemblyConfigurationAttribute>
    <GenerateNeutralResourcesLanguageAttribute>true</GenerateNeutralResourcesLanguageAttribute>
    <GenerateAssemblyDescriptionAttribute>true</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyTitleAttribute>true</GenerateAssemblyTitleAttribute>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>

    <!-- Assembly attributes (replacing AssemblyInfo.Common.cs) -->
    <NeutralLanguage>en-US</NeutralLanguage>
    <CLSCompliant>true</CLSCompliant>
    <ComVisible>false</ComVisible>

    <!-- Package Metadata (for NuGet packages) -->
    <Authors>Richard Murillo</Authors>
    <Company>Qwiq Contributors</Company>
    <Product>Qwiq - Quick Work Item Queries</Product>
    <Copyright>Copyright (c) 2025 Qwiq Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rjmurillo/Qwiq</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rjmurillo/Qwiq.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Microsoft;Team Foundation Server;TFS;Azure DevOps;VSO;Visual Studio Online;Agile;WIT;Work Item Tracking;VSTS;TeamFoundation</PackageTags>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Suppress CA warnings for existing technical debt -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1000;CA1001;CA1002;CA1003;CA1008;CA1010;CA1012;CA1014;CA1016;CA1017;CA1018;CA1024;CA1027;CA1028;CA1030;CA1031;CA1032;CA1033;CA1034;CA1036;CA1040;CA1041;CA1043;CA1044;CA1045;CA1046;CA1047;CA1050;CA1051;CA1052;CA1054;CA1055;CA1056;CA1058;CA1060;CA1061;CA1062;CA1063;CA1064;CA1065;CA1066;CA1067;CA1068;CA1069;CA1070;CA1200;CA1303;CA1304;CA1305;CA1307;CA1308;CA1309;CA1310;CA1401;CA1416;CA1417;CA1418;CA1419;CA1501;CA1502;CA1505;CA1506;CA1507;CA1508;CA1509;CA1700;CA1707;CA1708;CA1710;CA1711;CA1712;CA1715;CA1716;CA1720;CA1721;CA1724;CA1725;CA1801;CA1802;CA1805;CA1806;CA1810;CA1812;CA1813;CA1814;CA1815;CA1816;CA1819;CA1820;CA1821;CA1822;CA1823;CA1824;CA1825;CA1826;CA1827;CA1828;CA1829;CA1830;CA1831;CA1832;CA1833;CA1834;CA1835;CA1836;CA1837;CA1838;CA1839;CA1840;CA1841;CA1842;CA1843;CA1844;CA1845;CA1846;CA1847;CA1848;CA1849;CA1850;CA1851;CA1852;CA1853;CA1854;CA1855;CA1856;CA1857;CA1858;CA1859;CA1860;CA1861;CA2000;CA2002;CA2007;CA2008;CA2009;CA2011;CA2012;CA2013;CA2014;CA2015;CA2016;CA2017;CA2018;CA2100;CA2101;CA2109;CA2119;CA2153;CA2200;CA2201;CA2207;CA2208;CA2211;CA2213;CA2214;CA2215;CA2216;CA2217;CA2219;CA2225;CA2226;CA2227;CA2229;CA2231;CA2234;CA2235;CA2237;CA2241;CA2242;CA2243;CA2244;CA2245;CA2246;CA2247;CA2248;CA2249;CA2250;CA2251;CA2252;CA2253;CA2254;CA2300;CA2301;CA2302;CA2305;CA2310;CA2311;CA2312;CA2315;CA2321;CA2322;CA2326;CA2327;CA2328;CA2329;CA2330;CA3001;CA3002;CA3003;CA3004;CA3005;CA3006;CA3007;CA3008;CA3009;CA3010;CA3011;CA3012;CA3061;CA3075;CA3076;CA3077;CA3147;CA5350;CA5351;CA5358;CA5359;CA5360;CA5361;CA5362;CA5363;CA5364;CA5365;CA5366;CA5367;CA5368;CA5369;CA5370;CA5371;CA5372;CA5373;CA5374;CA5375;CA5376;CA5377;CA5378;CA5379;CA5380;CA5381;CA5382;CA5383;CA5384;CA5385;CA5386;CA5387;CA5388;CA5389;CA5390;CA5391;CA5392;CA5393;CA5394;CA5395;CA5396;CA5397;CA5398;CA5399;CA5400;CA5401;CA5402;CA5403;IDE0001;IDE0002;IDE0003;IDE0004;IDE0005;IDE0007;IDE0008;IDE0009;IDE0010;IDE0011;IDE0016;IDE0017;IDE0018;IDE0019;IDE0020;IDE0021;IDE0022;IDE0023;IDE0024;IDE0025;IDE0026;IDE0027;IDE0028;IDE0029;IDE0030;IDE0031;IDE0032;IDE0033;IDE0034;IDE0035;IDE0036;IDE0037;IDE0038;IDE0039;IDE0040;IDE0041;IDE0042;IDE0044;IDE0045;IDE0046;IDE0047;IDE0048;IDE0049;IDE0050;IDE0051;IDE0052;IDE0053;IDE0054;IDE0055;IDE0056;IDE0057;IDE0058;IDE0059;IDE0060;IDE0061;IDE0062;IDE0063;IDE0064;IDE0065;IDE0066;IDE0070;IDE0071;IDE0072;IDE0073;IDE0074;IDE0075;IDE0076;IDE0077;IDE0078;IDE0079;IDE0080;IDE0082;IDE0083;IDE0084;IDE0090;IDE0100;IDE0110;IDE0120;IDE0130;IDE0140;IDE0150;IDE0160;IDE0161;IDE0170;IDE0180;IDE0190;IDE0200;IDE0210;IDE0211;IDE0220;IDE0230;IDE0240;IDE0241;IDE0250;IDE0251;IDE0260;IDE0270;IDE0280;IDE0290;IDE0300;IDE0301;IDE0302;IDE0303;IDE0304;IDE0305;IDE1005;IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Add Nerdbank.GitVersioning for all projects -->
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />

    <!-- Add Microsoft.CodeAnalysis.NetAnalyzers to replace deprecated FxCop -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />

    <!-- InternalsVisibleTo for Castle DynamicProxy (used by Moq) - replaces AssemblyInfo.Common.cs -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
