<Project>
  <ItemGroup>
    <!-- Add Nerdbank.GitVersioning for all projects -->
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.6.143" PrivateAssets="all" />
    
    <!-- Add Microsoft.CodeAnalysis.NetAnalyzers to replace deprecated FxCop -->
    <!-- See: https://learn.microsoft.com/en-us/visualstudio/code-quality/migrate-from-legacy-analysis-to-net-analyzers -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
